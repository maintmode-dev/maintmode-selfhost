# Environment — holds the OAuth client secret and the database password.
.env
.env.*
!.env.example

# Backend secrets — signing key, encryption key, database DSN.
config/app.secrets.yaml
config/app.secrets.*.yaml
!config/app.secrets.example.yaml

# Anything else credential-shaped that lands here by accident.
*.pem
*.key
secrets/

# Local data and backups. Compose keeps its data in named volumes, but backup
# dumps and any bind-mounted directory tend to end up in the working tree.
data/
backups/
*.dump
*.sql.gz

# Compose overrides are per-host by convention.
compose.override.yaml
compose.override.yml
docker-compose.override.yaml
docker-compose.override.yml

# OS and editor noise.
.DS_Store
Thumbs.db
*.swp
.idea/
.vscode/
