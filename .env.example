# MaintMode — self-hosted environment.
#
#   cp .env.example .env
#
# Then fill in every value marked REQUIRED below. `docker compose up` fails
# fast and names the variable if one is missing, so you cannot half-configure
# your way into a broken instance.
#
# .env is gitignored. Keep it that way — it holds your session secret and your
# database and Valkey passwords.
#
# NOTE: this file configures the frontend, the database and Valkey. The BACKEND
# reads its own secrets (Google client secret included) from
# config/app.secrets.yaml, which you create separately — see README.md,
# "Generate secrets". The database and Valkey passwords appear in BOTH places
# and each pair must match.

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------

# REQUIRED. Password for the `maintmode` Postgres role.
#
#   openssl rand -hex 32
#
# This value is baked into the database on FIRST start only. Changing it later
# does not change the password Postgres actually enforces — you would have to
# ALTER the role by hand (or delete the volume and lose your data). Pick it
# once, and copy the same value into config/app.secrets.yaml under `db/dsn`.
POSTGRES_PASSWORD=

# REQUIRED. Password Valkey requires from every client.
#
#   openssl rand -hex 32
#
# Use hex: the value is written into Valkey's config file in quotes. Unlike the
# database password it is applied on every start, so changing it later works —
# change it here and in config/app.secrets.yaml (`valkey/password`) together.
VALKEY_PASSWORD=

# ---------------------------------------------------------------------------
# Frontend auth shell
# ---------------------------------------------------------------------------

# REQUIRED. Signs the browser session cookie. Minimum 32 characters; below
# that the frontend still starts, but every page answers HTTP 500 and
# `docker compose logs ui` names this variable.
#
#   openssl rand -hex 32
#
# Rotating this invalidates every logged-in session — which is exactly what you
# want if it ever leaks.
MAINTMODE_AUTH_SECRET=

# REQUIRED. The public URL users type into a browser, with no trailing slash.
#
# This is NOT cosmetic. The browser is sent to <this URL>/auth/... to start
# Google sign-in, and the redirect URI you registered in Google Cloud Console
# starts with it too. It must match app.frontend_url in config/app.config.yaml.
#
#   Local, no proxy:       http://localhost:3000
#   Behind TLS on a host:  https://maintmode.example.com
MAINTMODE_APP_BASE_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# Networking (optional)
# ---------------------------------------------------------------------------

# Host interface the gateway port binds to. Defaults to 127.0.0.1 — reachable
# from the host itself and from a reverse proxy running on it, but NOT from the
# network. Keep it that way until you have signed in as the first administrator
# and set the instance up.
#
# Set to 0.0.0.0 to expose it directly — preferably never, in favour of a
# reverse proxy terminating TLS.
# MAINTMODE_BIND_ADDRESS=127.0.0.1

# Host port for the gateway. Change it if 3000 is already taken. Note this
# changes only the HOST side, so if you are not behind a proxy you must update
# MAINTMODE_APP_BASE_URL, app.frontend_url, and both redirect URIs (Google's and
# the one in app.config.yaml) to match.
# MAINTMODE_HTTP_PORT=3000

# How long the frontend waits on a backend call, in milliseconds.
# MAINTMODE_API_TIMEOUT_MS=10000

# ---------------------------------------------------------------------------
# Image versions
# ---------------------------------------------------------------------------
# CI publishes images tagged by branch (`main`), by release tag (`v1.2.3`) and
# by commit (`sha-abc1234`), and points `latest` at the newest release. `main`
# tracks the newest build and `latest` moves with every release; a release tag
# is what you want in production, because it is the only one that does not
# move under you.
MAINTMODE_VERSION=main
MAINTMODE_UI_VERSION=main
